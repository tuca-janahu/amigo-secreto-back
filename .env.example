# Crie um arquivo .env na raiz do projeto e configure as variáveis de ambiente conforme abaixo:
NODE_ENV=development
PORT=3333
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amigo_secreto?schema=public"
FRONTEND_URL="http://localhost:5173"

# Gere um segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=""

# Gere uma chave AES-256 com `openssl rand -base64 32` (44 caracteres Base64).
DATA_ENCRYPTION_KEY=""

# Gere uma chave AES-256 exclusiva para os resultados de sorteio.
SORTEIO_ENCRYPTION_KEY=""

# Gere um segredo com pelo menos 32 caracteres.
EMAIL_LOOKUP_SECRET=""
